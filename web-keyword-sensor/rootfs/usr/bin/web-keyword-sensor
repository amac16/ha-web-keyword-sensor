#!/usr/bin/env python3
"""Scrape configured web pages and publish MQTT discovery entities."""
import hashlib, html, json, logging, os, re, signal, threading, time
from concurrent.futures import ThreadPoolExecutor
from urllib.parse import urlparse
import paho.mqtt.client as mqtt
import pyotp
import requests
from ai_providers import evaluate
from web_ui import AIProfileStore, BrowserSessions, CheckStore, start_server

LOG = logging.getLogger("web_keyword_sensor")
STOP = threading.Event()
TAGS = re.compile(r"<[^>]+>")
SPACE = re.compile(r"\s+")
UNITS = {"seconds": 1, "minutes": 60, "hours": 3600, "days": 86400, "weeks": 604800}
WEEKDAYS = ("monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday")

def text(value): return SPACE.sub(" ", html.unescape(TAGS.sub(" ", value))).strip()
def slug(value): return re.sub(r"[^a-z0-9]+", "_", value.lower()).strip("_") or "web_keyword"
def ident(check): return f"{slug(check.get('name', 'web keyword'))}_{hashlib.sha1(str(check.get('url', '')).encode(), usedforsecurity=False).hexdigest()[:8]}"
def valid(check):
    try:
        p = urlparse(check["url"]); phrase_ok = bool(check.get("phrase")) or (check.get("match_mode") == "ai_context" and bool(check.get("context_prompt")))
        return p.scheme in ("http", "https") and bool(p.netloc) and phrase_ok
    except (KeyError, TypeError): return False
def initial_checks(options):
    raw = options.get("checks", "[]")
    try: checks = raw if isinstance(raw, list) else json.loads(raw)
    except (TypeError, json.JSONDecodeError): checks = []
    if not isinstance(checks, list): return []
    checks = [check for check in checks[:100] if isinstance(check, dict)]
    for check in checks:
        check.setdefault("id", ident(check))
    return checks
def in_schedule(check, timestamp=None):
    now = time.localtime(timestamp) if timestamp is not None else time.localtime()
    days = check.get("days", list(WEEKDAYS))
    if WEEKDAYS[now.tm_wday] not in days: return False
    def minutes(value, default):
        try:
            hour, minute = (int(x) for x in value.split(":", 1)); return hour * 60 + minute
        except (AttributeError, ValueError): return default
    current = now.tm_hour * 60 + now.tm_min
    start = minutes(check.get("time_from", "00:00"), 0)
    end = minutes(check.get("time_to", "23:00"), 1439)
    return start <= current <= end if start <= end else current >= start or current <= end

class App:
    def __init__(self, options):
        self.options = options; self.store = CheckStore(initial_checks(options)); self.ai_profiles = AIProfileStore(); self.browser = BrowserSessions(self.store); self.running = set(); self.due = {}; self.known = {}; self.state_lock = threading.RLock(); self.ai_lock = threading.BoundedSemaphore(1)
        try: configured_workers = int(options.get("max_concurrent_checks", 2))
        except (TypeError, ValueError): configured_workers = 2
        self.max_workers = max(1, min(configured_workers, 8))
        self.executor = ThreadPoolExecutor(max_workers=self.max_workers, thread_name_prefix="keyword-check")
        self.client = mqtt.Client(mqtt.CallbackAPIVersion.VERSION2, client_id="web-keyword-sensor")
        if options.get("mqtt_username"): self.client.username_pw_set(options["mqtt_username"], options.get("mqtt_password") or None)
        self.client.will_set("web_keyword_sensor/status", "offline", qos=1, retain=True); self.client.on_connect = self.connected; self.client.on_disconnect = self.disconnected
    def connected(self, client, userdata, flags, reason_code, properties=None):
        if reason_code == 0: client.publish("web_keyword_sensor/status", "online", qos=1, retain=True); LOG.info("Connected to MQTT")
        else: LOG.error("MQTT connection rejected: %s", reason_code)
    def disconnected(self, client, userdata, flags, reason_code, properties=None):
        if not STOP.is_set(): LOG.warning("MQTT disconnected: %s", reason_code)
    def connect(self):
        self.client.reconnect_delay_set(min_delay=2, max_delay=60)
        self.client.loop_start()
        # connect_async keeps a broker outage from preventing the ingress UI and
        # scheduler from starting.  Paho's network thread retries on its own.
        self.client.connect_async(self.options.get("mqtt_host", "homeassistant.local"), int(self.options.get("mqtt_port", 1883)))
    def discovery(self, check):
        name = ident(check); base = f"web_keyword_sensor/{name}"; component = check["entity_type"]
        config = {"name": check["name"], "unique_id": f"web_keyword_sensor_{name}", "state_topic": f"{base}/state", "availability_topic": f"{base}/availability", "payload_available": "online", "payload_not_available": "offline", "json_attributes_topic": f"{base}/attributes", "device": {"identifiers": ["web_keyword_sensor"], "name": "Web Keyword Sensor", "manufacturer": "Web Keyword Sensor"}}
        if component == "binary_sensor": config.update(payload_on="ON", payload_off="OFF")
        elif check.get("match_mode") == "ai_context": config.update(icon="mdi:robot-search")
        else: config.update(unit_of_measurement="matches", icon="mdi:text-search")
        self.client.publish(f"{self.options.get('discovery_prefix', 'homeassistant').strip('/')}/{component}/{name}/config", json.dumps(config), qos=1, retain=True); return f"{base}/state"
    def run(self, check, state_topic):
        if not check.get("enabled", True): return {"ok": False, "error": "check is disabled"}
        try:
            headers = {"User-Agent": "Home Assistant Web Keyword Sensor/1.0"}; headers.update(check.get("headers") or {})
            timeout = max(5, min(int(self.options.get("request_timeout", 30)), 120)); verify = check.get("verify_ssl", True)
            max_bytes = max(64 * 1024, min(int(self.options.get("max_response_bytes", 2 * 1024 * 1024)), 16 * 1024 * 1024))
            status = None
            if check.get("auth_mode", "basic") == "browser":
                try: status, response_text = self.browser.fetch(check)
                except Exception as error:
                    if check.get("match_mode") == "ai_context": self.ai_unavailable(check, state_topic, "browser request failed")
                    else: self.auth_failure(check, str(error))
                    return {"ok": False, "error": str(error)[:300]}
                if status in (401, 403):
                    if check.get("match_mode") == "ai_context": self.ai_unavailable(check, state_topic, f"browser session expired or invalid (HTTP {status})")
                    else: self.auth_failure(check, f"browser session expired or invalid (HTTP {status})")
                    return {"ok": False, "error": "authentication failed"}
                if status >= 400: raise requests.HTTPError(f"browser request failed (HTTP {status})")
            else:
                with requests.Session() as session:
                    if check.get("login_url"):
                        if not check.get("username") or not check.get("password"):
                            self.auth_failure(check, "credentials are missing"); return {"ok": False, "error": "credentials are missing"}
                        login = {check.get("username_field", "username"): check["username"], check.get("password_field", "password"): check["password"]}
                        if check.get("totp_secret"):
                            login[check.get("totp_field", "totp")] = pyotp.TOTP(check["totp_secret"]).now()
                        auth_response = session.post(check["login_url"], data=login, headers=headers, timeout=timeout, verify=verify, stream=True)
                        success_text = check.get("success_text")
                        auth_body = self.read_response(auth_response, max_bytes)
                        if auth_response.status_code >= 400 or (success_text and success_text not in auth_body):
                            self.auth_failure(check, f"login rejected (HTTP {auth_response.status_code})"); return {"ok": False, "error": "login rejected"}
                        check["auth_status"] = "Credentials successful"
                        self.store.put(check)
                    response = session.get(check["url"], headers=headers, timeout=timeout, verify=verify, stream=True)
                    status = response.status_code
                    if status in (401, 403):
                        self.auth_failure(check, f"credentials expired or invalid (HTTP {status})"); return {"ok": False, "error": "credentials expired or invalid"}
                    response.raise_for_status(); response_text = self.read_response(response, max_bytes)
            page_text = text(response_text)
            if check.get("match_mode") == "ai_context":
                profile = next((x for x in self.ai_profiles.get_runtime() if x.get("id") == check.get("ai_profile_id") and x.get("enabled", True)), None)
                if not profile: self.ai_unavailable(check, state_topic, "AI profile is missing or disabled"); return {"ok": False, "error": "AI profile is missing or disabled"}
                with self.ai_lock:
                    result = evaluate(profile, check.get("context_prompt", ""), page_text, profile.get("timeout", self.options.get("request_timeout", 30)))
                found = result["match"]
                value = ("ON" if found else "OFF") if check["entity_type"] == "binary_sensor" else (result["summary"] or ("Relevant information found." if found else "No relevant information found."))
                attrs = {"url": check["url"], "match_mode": "ai_context", "matched": found, "summary": result["summary"], "findings": result["findings"], "checked_at": int(time.time()), "http_status": status, "ai_profile": profile.get("name", profile.get("id")), "ai_model": profile.get("model")}
            else:
                found = check["phrase"] in page_text if check.get("case_sensitive") else check["phrase"].casefold() in page_text.casefold()
                value = ("ON" if found else "OFF") if check["entity_type"] == "binary_sensor" else ("1" if found else "0")
                attrs = {"url": check["url"], "phrase": check["phrase"], "matched": found, "checked_at": int(time.time()), "http_status": status}
            base = state_topic.rsplit("/", 1)[0]
            self.client.publish(base + "/availability", "online", qos=1, retain=True); self.client.publish(state_topic, value, qos=1, retain=True); self.client.publish(base + "/attributes", json.dumps(attrs), qos=1, retain=True); LOG.info("%s: %s", check["name"], "matched" if found else "not matched")
            return {"ok": True, "state": value, "attributes": attrs}
        except requests.RequestException as error:
            if check.get("match_mode") == "ai_context": self.ai_unavailable(check, state_topic, "provider request failed")
            LOG.warning("%s: request failed: %s", check.get("name", "unnamed"), error)
            return {"ok": False, "error": "request failed"}
        except Exception as error:
            if check.get("match_mode") == "ai_context": self.ai_unavailable(check, state_topic, "AI evaluation failed")
            LOG.exception("%s: check failed", check.get("name", "unnamed"))
            return {"ok": False, "error": "check failed: " + str(error)[:300]}
    def ai_unavailable(self, check, state_topic, reason):
        self.client.publish(state_topic.rsplit("/", 1)[0] + "/availability", "offline", qos=1, retain=True)
        check["auth_status"] = "AI unavailable: " + reason
        self.store.put(check)
    def interval_seconds(self, check):
        try: return max(1, int(check.get("interval", 15))) * UNITS.get(check.get("unit", "minutes"), 60)
        except (TypeError, ValueError): return 900
    def mark_run_start(self, check):
        check["last_ran_at"] = time.time()
        self.store.put(check)
    def mark_next_run(self, check, interval=None):
        interval = interval if interval is not None else self.interval_seconds(check)
        candidate = time.time() + interval
        # Show the next eligible scheduled time, not merely the next interval,
        # when a check's weekday/time window would otherwise be closed.
        for _ in range(8 * 24 * 60):
            if in_schedule(check, candidate): break
            candidate += 60
        check["next_run_at"] = candidate
        self.store.put(check)
    def test_check(self, ident_):
        check = next((x for x in self.store.get_runtime() if x.get("id") == ident_), None)
        if not check or not valid(check): return {"ok": False, "error": "check is missing or invalid"}
        with self.state_lock:
            if ident_ in self.running: return {"ok": False, "error": "check is already running"}
            if ident_ not in self.known:
                try: self.known[ident_] = self.discovery(check)
                except Exception: return {"ok": False, "error": "unable to publish discovery"}
            self.running.add(ident_)
        try:
            self.mark_run_start(check)
            return self.run(check, self.known[ident_])
        finally:
            self.mark_next_run(check)
            with self.state_lock: self.running.discard(ident_)
    @staticmethod
    def read_response(response, max_bytes):
        data = bytearray()
        for chunk in response.iter_content(65536):
            data.extend(chunk)
            if len(data) >= max_bytes: break
        response.close()
        return bytes(data[:max_bytes]).decode(response.encoding or "utf-8", errors="replace")
    def auth_failure(self, check, reason):
        check["auth_status"] = f"Authentication failed: {reason}"
        self.store.put(check)
        LOG.error("%s: authentication failed: %s", check.get("name", "unnamed"), reason)
        token = os.environ.get("SUPERVISOR_TOKEN")
        if token:
            try:
                requests.post("http://supervisor/core/api/services/persistent_notification/create", headers={"Authorization": f"Bearer {token}"}, json={"title": "Web Keyword Sensor authentication failure", "message": f"Authentication failed for {check.get('name', 'unnamed')}: {reason}"}, timeout=10)
            except requests.RequestException: LOG.warning("Unable to create Home Assistant notification")
    def start(self):
        self.connect(); start_server(self.store, self.browser, self.ai_profiles, self.test_check); LOG.info("Web form available through app ingress")
        while not STOP.wait(1):
            now = time.monotonic(); current = set()
            for check in self.store.get_runtime():
                if not valid(check): continue
                cid = check.setdefault("id", ident(check)); current.add(cid)
                if cid not in self.known:
                    try: self.known[cid] = self.discovery(check); self.due[cid] = 0
                    except Exception: LOG.exception("Unable to publish discovery for %s", check.get("name", "unnamed")); continue
                with self.state_lock:
                    available = len(self.running) < self.max_workers
                    if in_schedule(check) and self.due.get(cid, 0) <= now and cid not in self.running and available:
                        self.running.add(cid)
                        state_topic = self.known[cid]
                        def task(item=check, ident_=cid, topic=state_topic):
                            try:
                                self.mark_run_start(item)
                                self.run(item, topic)
                            except Exception: LOG.exception("Unhandled check failure: %s", item.get("name", "unnamed"))
                            finally:
                                with self.state_lock:
                                    self.running.discard(ident_)
                                    interval = self.interval_seconds(item)
                                    self.due[ident_] = time.monotonic() + interval
                                    self.mark_next_run(item, interval)
                        self.executor.submit(task)
            for cid in set(self.known) - current:
                self.known.pop(cid); self.due.pop(cid, None)
        self.executor.shutdown(wait=True, cancel_futures=True)
        self.browser.close_all()
        self.client.loop_stop(); self.client.disconnect()

def main():
    logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s")
    with open("/data/options.json", encoding="utf-8") as file: options = json.load(file)
    for sig in (signal.SIGTERM, signal.SIGINT): signal.signal(sig, lambda *_: STOP.set())
    App(options).start()
if __name__ == "__main__": main()
