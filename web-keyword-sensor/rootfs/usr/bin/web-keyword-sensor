#!/usr/bin/env python3
"""Scrape configured web pages and publish MQTT discovery entities."""
import hashlib, html, json, logging, re, signal, threading, time
from urllib.parse import urlparse
import paho.mqtt.client as mqtt
import requests
from web_ui import CheckStore, start_server

LOG = logging.getLogger("web_keyword_sensor")
STOP = threading.Event()
TAGS = re.compile(r"<[^>]+>")
SPACE = re.compile(r"\s+")
UNITS = {"seconds": 1, "minutes": 60, "hours": 3600, "days": 86400, "weeks": 604800}

def text(value): return SPACE.sub(" ", html.unescape(TAGS.sub(" ", value))).strip()
def slug(value): return re.sub(r"[^a-z0-9]+", "_", value.lower()).strip("_") or "web_keyword"
def ident(check): return f"{slug(check['name'])}_{hashlib.sha1(check['url'].encode(), usedforsecurity=False).hexdigest()[:8]}"
def valid(check):
    try:
        p = urlparse(check["url"]); return p.scheme in ("http", "https") and bool(p.netloc) and bool(check["phrase"])
    except (KeyError, TypeError): return False
def initial_checks(options):
    raw = options.get("checks", "[]")
    try: checks = raw if isinstance(raw, list) else json.loads(raw)
    except (TypeError, json.JSONDecodeError): checks = []
    for check in checks: check.setdefault("id", ident(check))
    return checks

class App:
    def __init__(self, options):
        self.options = options; self.store = CheckStore(initial_checks(options)); self.running = set(); self.due = {}; self.known = {}
        self.client = mqtt.Client(mqtt.CallbackAPIVersion.VERSION2, client_id="web-keyword-sensor")
        if options.get("mqtt_username"): self.client.username_pw_set(options["mqtt_username"], options.get("mqtt_password") or None)
        self.client.will_set("web_keyword_sensor/status", "offline", qos=1, retain=True); self.client.on_connect = self.connected; self.client.on_disconnect = self.disconnected
    def connected(self, client, userdata, flags, reason_code, properties=None):
        if reason_code == 0: client.publish("web_keyword_sensor/status", "online", qos=1, retain=True); LOG.info("Connected to MQTT")
        else: LOG.error("MQTT connection rejected: %s", reason_code)
    def disconnected(self, client, userdata, flags, reason_code, properties=None):
        if not STOP.is_set(): LOG.warning("MQTT disconnected: %s", reason_code)
    def connect(self):
        self.client.connect(self.options.get("mqtt_host", "homeassistant.local"), int(self.options.get("mqtt_port", 1883))); self.client.loop_start()
    def discovery(self, check):
        name = ident(check); base = f"web_keyword_sensor/{name}"; component = check["entity_type"]
        config = {"name": check["name"], "unique_id": f"web_keyword_sensor_{name}", "state_topic": f"{base}/state", "availability_topic": "web_keyword_sensor/status", "payload_available": "online", "payload_not_available": "offline", "json_attributes_topic": f"{base}/attributes", "device": {"identifiers": ["web_keyword_sensor"], "name": "Web Keyword Sensor", "manufacturer": "Web Keyword Sensor"}}
        if component == "binary_sensor": config.update(payload_on="ON", payload_off="OFF")
        else: config.update(unit_of_measurement="matches", icon="mdi:text-search")
        self.client.publish(f"{self.options.get('discovery_prefix', 'homeassistant').strip('/')}/{component}/{name}/config", json.dumps(config), qos=1, retain=True); return f"{base}/state"
    def run(self, check, state_topic):
        try:
            headers = {"User-Agent": "Home Assistant Web Keyword Sensor/1.0"}; headers.update(check.get("headers") or {})
            response = requests.get(check["url"], headers=headers, timeout=int(self.options.get("request_timeout", 30)), verify=check.get("verify_ssl", True)); response.raise_for_status()
            found = check["phrase"] in text(response.text) if check.get("case_sensitive") else check["phrase"].casefold() in text(response.text).casefold()
            value = ("ON" if found else "OFF") if check["entity_type"] == "binary_sensor" else ("1" if found else "0")
            attrs = {"url": check["url"], "phrase": check["phrase"], "matched": found, "checked_at": int(time.time()), "http_status": response.status_code}
            self.client.publish(state_topic, value, qos=1, retain=True); self.client.publish(state_topic.rsplit("/", 1)[0] + "/attributes", json.dumps(attrs), qos=1, retain=True); LOG.info("%s: %s", check["name"], "matched" if found else "not matched")
        except requests.RequestException as error: LOG.warning("%s: request failed: %s", check.get("name", "unnamed"), error)
        except Exception: LOG.exception("%s: check failed", check.get("name", "unnamed"))
    def start(self):
        self.connect(); start_server(self.store); LOG.info("Web form available through app ingress")
        while not STOP.wait(1):
            now = time.monotonic(); current = set()
            for check in self.store.get():
                if not valid(check): continue
                cid = check.setdefault("id", ident(check)); current.add(cid)
                if cid not in self.known: self.known[cid] = self.discovery(check); self.due[cid] = 0
                if self.due.get(cid, 0) <= now and cid not in self.running:
                    self.running.add(cid)
                    def task(item=check, ident_=cid):
                        try: self.run(item, self.known[ident_])
                        finally: self.running.discard(ident_); self.due[ident_] = time.monotonic() + int(item["interval"]) * UNITS[item["unit"]]
                    threading.Thread(target=task, daemon=True).start()
            for cid in set(self.known) - current:
                self.known.pop(cid); self.due.pop(cid, None)
        self.client.loop_stop(); self.client.disconnect()

def main():
    logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s")
    with open("/data/options.json", encoding="utf-8") as file: options = json.load(file)
    for sig in (signal.SIGTERM, signal.SIGINT): signal.signal(sig, lambda *_: STOP.set())
    App(options).start()
if __name__ == "__main__": main()
